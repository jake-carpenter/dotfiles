{
  // MISC / EXTENSIONS
  "accessibility.signals.lineHasInlineSuggestion": {
    "sound": "off"
  },
  "color-highlight.markRuler": false,
  "debug.allowBreakpointsEverywhere": true,
  "debug.toolBarLocation": "docked",
  "extensions.ignoreRecommendations": true,
  "reactCompilerMarker.errorEmoji": "🚫",
  "reactCompilerMarker.successEmoji": "✨",
  "reactCompilerMarker.supportedExtensions": [
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".mjs",
    ".cjs"
  ],
  "redhat.telemetry.enabled": true,
  "screencastMode.fontSize": 36,
  "search.defaultViewMode": "tree",
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/ios": true,
    "**/android": true
  },
  "security.promptForLocalFileProtocolHandling": false,
  "security.workspace.trust.untrustedFiles": "open",
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "yaml.disableSchemaDetection": [],
  "chat.fontSize": 14,
  "chat.instructionsFilesLocations": {
    ".github/instructions.md": true
  },
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true,
    "windsurf": true,
    "cursor-global": true,
    "cursor-workspace": true
  },
  // ---------- EDITOR ----------
  "editor.bracketPairColorization.enabled": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontFamily": "'Monaspace Argon', 'Ubuntu Nerd Font Mono', monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
  "editor.fontWeight": "normal",
  "editor.formatOnSave": true,
  "editor.glyphMargin": true,
  "editor.guides.bracketPairs": false,
  "editor.guides.bracketPairsHorizontal": false,
  "editor.guides.indentation": false,
  "editor.inlineSuggest.edits.allowCodeShifting": "horizontal",
  "editor.inlineSuggest.edits.renderSideBySide": "auto",
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.showToolbar": "always",
  "editor.inlineSuggest.syntaxHighlightingEnabled": true,
  "editor.insertSpaces": true,
  "editor.lineHeight": 1.4,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.tabSize": 2,
  "editor.suggestSelection": "first",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "emphasis",
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": "strong",
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": "entity.other.attribute-name",
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": "markup.underline",
        "settings": {
          "fontStyle": "underline"
        }
      },
      {
        "scope": "markup.bold",
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": "markup.heading",
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": "markup.italic",
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": "storage.type",
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": "storage.modifier",
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "name": "String interpolation",
        "scope": [
          "punctuation.definition.template-expression.begin",
          "punctuation.definition.template-expression.end",
          "punctuation.section.embedded"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": "keyword.control",
        "settings": {
          "fontStyle": "italic bold"
        }
      },
      {
        "scope": [
          "keyword.operator.new",
          "keyword.operator.expression",
          "keyword.operator.cast",
          "keyword.operator.sizeof",
          "keyword.operator.logical.python"
        ],
        "settings": {
          "fontStyle": "italic bold"
        }
      },
      {
        "name": "this.self",
        "scope": "variable.language",
        "settings": {
          "fontStyle": "italic",
          "foreground": "#ff5874"
        }
      },
      {
        "name": "@Decorator",
        "scope": [
          "meta.decorator punctuation.decorator"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "punctuation.definition.comment",
          "comment"
        ],
        "settings": {
          "fontStyle": "bold italic"
        }
      },
      {
        "scope": "entity.name.function",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.wordWrap": "off",
  "editor.wordWrapColumn": 120,
  "emmet.excludeLanguages": [
    "markdown",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  // ---------- EXPLORER ----------
  "explorer.confirmDelete": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.*",
    "*.tsx": "${capture}.*",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, pnpm-lock.yaml, bun.lock"
  },
  // ---------- FILES ----------
  "files.associations": {
    "*.yml": "yaml",
    "*.webc": "html",
    ".chezmoi*.yaml": "helm",
    "*.tmpl": "helm"
  },
  "files.autoSave": "onWindowChange",
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.expo-shared": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/bower_components": true,
    "**/CVS": true,
    "**/node_modules": true,
    "**/tmp": true
  },
  "files.watcherExclude": {
    "**/.expo": true,
    "**/.expo-shared": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.husky": true,
    "**/.vscode": true,
    "**/android": true,
    "**/bower_components/**": true,
    "**/dist/**": true,
    "**/ios/": true,
    "**/node_modules/**": true,
    "**/tmp/**": true
  },
  // ---------- GIT / DIFF----------
  "diffEditor.wordWrap": "off",
  "mergeEditor.diffAlgorithm": "advanced-wasm",
  "git.enableSmartCommit": true,
  "git.mergeEditor": true,
  "git.openRepositoryInParentFolders": "never",
  // ---------- JAVASCRIPT / TYPESCRIPT ----------
  "js/ts.format.enabled": true,
  "js/ts.format.insertSpaceAfterCommaDelimiter": true,
  "js/ts.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
  "js/ts.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
  "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingEmptyBraces": false,
  "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,
  "js/ts.format.semicolons": "remove",
  "js/ts.implementationsCodeLens.enabled": true,
  "js/ts.preferences.importModuleSpecifier": "shortest",
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.referencesCodeLens.showOnAllFunctions": true,
  "js/ts.tsc.autoDetect": "on",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.validate.enabled": true,
  // ---------- JSON ----------
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://models.dev": true,
    "https://opencode.ai": true,
    "https://unpkg.com": true,
    "https://raw.githubusercontent.com/catppuccin/": true,
    "https://biomejs.dev": true
  },
  // ---------- TERMINAL ----------
  "terminal.external.linuxExec": "",
  "terminal.external.osxExec": "Warp.app",
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.fontFamily": "'MonaspiceKr Nerd Font', 'Hack Nerd Font Mono', monospace",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 11,
  "terminal.integrated.fontWeightBold": "bold",
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.lineHeight": 1.1,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.smoothScrolling": true,
  // ---------- WORKBENCH ----------
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Catppuccin Macchiato",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.wrapTabs": true,
  "workbench.preferredDarkColorTheme": "Catppuccin Macchiato",
  "workbench.preferredHighContrastLightColorTheme": "Catppuccin Latte",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.startupEditor": "none",
  // ---------- FILE-SPECIFIC ----------
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[fish]": {
    "editor.defaultFormatter": "bmalehorn.vscode-fish",
    "editor.rulers": [
      100
    ]
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[html][liquid]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.rulers": [
      100
    ],
    "editor.wordWrapColumn": 100
  },
  "[json][jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.rulers": [
      100
    ]
  },
  "[markdown]": {
    "editor.defaultFormatter": "vscode.markdown-language-features"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[yaml]": {
    "editor.autoIndent": "keep",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.rulers": [
      100
    ],
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    }
  },
  // DICTIONARY / SPELL CHECK
  "cSpell.userWords": [
    "tmpl",
    "webc"
  ]
  // ANYTHING NOT ORGANIZED...
}