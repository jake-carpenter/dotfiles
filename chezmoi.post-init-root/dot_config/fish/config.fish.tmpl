# Homebrew
# https://github.com/orgs/Homebrew/discussions/4412#discussioncomment-8651316
if test -d /home/linuxbrew/.linuxbrew
    set -gx HOMEBREW_PREFIX /home/linuxbrew/.linuxbrew
    set -gx HOMEBREW_CELLAR $HOMEBREW_PREFIX/Cellar
    set -gx HOMEBREW_REPOSITORY $HOMEBREW_PREFIX/Homebrew
else if test -d /opt/homebrew
    set -gx HOMEBREW_PREFIX /opt/homebrew
    set -gx HOMEBREW_CELLAR $HOMEBREW_PREFIX/Cellar
    set -gx HOMEBREW_REPOSITORY $HOMEBREW_PREFIX
else if test -d /usr/local/Cellar
    or test -d /usr/local/Homebrew
    set -gx HOMEBREW_PREFIX /usr/local
    set -gx HOMEBREW_CELLAR $HOMEBREW_PREFIX/Cellar
    set -gx HOMEBREW_REPOSITORY $HOMEBREW_PREFIX
end

# Homebrew PATH: only add to fish_user_paths when a directory is not already there (no growth on re-source)
if set -q HOMEBREW_PREFIX
    set -l gnubin $HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin
    if test -d $gnubin
        and not contains -- $gnubin $fish_user_paths
        set -U --prepend fish_user_paths $gnubin
    end
    set -l brew_paths $HOMEBREW_PREFIX/bin $HOMEBREW_PREFIX/sbin
    set -l missing
    for p in $brew_paths
        if not contains -- $p $fish_user_paths
            set --append missing $p
        end
    end
    if set -q missing[1]
        set -U --prepend fish_user_paths $missing
    end
end
! set -q MANPATH; and set -gx MANPATH
set -gx MANPATH $HOMEBREW_PREFIX/share/man $MANPATH
! set -q INFOPATH; and set -gx INFOPATH
set -gx INFOPATH $HOMEBREW_PREFIX/share/info $INFOPATH
set -gx HOMEBREW_NO_AUTO_UPDATE 1

# Add these *after* Homebrew so `/opt/homebrew/bin` wins
set -gx PATH /usr/local/bin $PATH
fish_add_path $HOME/.local/bin

# pnpm
set -gx PNPM_HOME $HOME/Library/pnpm
if not string match -q -- $PNPM_HOME $PATH
    fish_add_path "$PNPM_HOME"
end

# fnm (Node version manager)
eval "$(fnm env --use-on-cd --version-file-strategy=recursive)"

# Android
set -gx JAVA_HOME /Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
set -gx ANDROID_SDK_ROOT $HOME/Library/Android/sdk
set -gx ANDROID_HOME $ANDROID_SDK_ROOT
fish_add_path $ANDROID_HOME
fish_add_path $ANDROID_HOME/platform-tools

# my env vars
set -gx EDITOR hx
set -gx VISUAL hx
set -gx GITIN_LINESIZE 20

# bun
set -gx BUN_INSTALL "$HOME/.bun"
fish_add_path $BUN_INSTALL/bin

# cargo (Rust)
fish_add_path "$HOME/.cargo/bin"

# dnvm (.NET)
fish_add_path "$HOME/Library/Application Support/dnvm"
fish_add_path "$HOME/.dotnet/tools"
set -gx DOTNET_ROOT "$HOME/Library/Application Support/dnvm/dn"

# dotnet stuff
set -gx DOTNET_NOLOGO 1
set -gx DOTNET_CLI_TELEMETRY_OPTOUT 1
set -gx DOTNET_SKIP_FIRST_TIME_EXPERIENCE 1

# abbr (aliases)
abbr -a rm rip
abbr -a vim hx
abbr -a p pnpm
abbr -a px pnpx
abbr -a bx bunx
abbr -a gi git
abbr -a gti git
abbr -a gb "gitin branch"
abbr -a gs "gitin status"
abbr -a gl "gitin log"

{{- if eq .chezmoi.config.destDir "/Users/a089947" }}

# [WORK] CA Cert configuration so Netskope doesn't break things with self-signed certs
set -gx NODE_EXTRA_CA_CERTS "/Library/Application Support/Netskope/STAgent/data/nscacert_combined.pem"
set -gx REQUESTS_CA_BUNDLE "/Library/Application Support/Netskope/STAgent/data/nscacert_combined.pem"
set -gx CURL_CA_BUNDLE "/Library/Application Support/Netskope/STAgent/data/nscacert_combined.pem"
set -gx GIT_SSL_CAPATH "/Library/Application Support/Netskope/STAgent/data/nscacert_combined.pem"
set -gx SSL_CERT_FILE "/Library/Application Support/Netskope/STAgent/data/nscacert_combined.pem"

# Quiets Kiota output during dotnet build
set -gx KIOTA_TUTORIAL_ENABLED 0

# Maestro CLI
fish_add_path $HOME/.maestro/bin

{{- end }}
